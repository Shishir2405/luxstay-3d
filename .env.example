# ───────────────────────────────────────────────────────────────────────────
# LuxStay 3D — environment template. Copy to `.env.local` and fill in.
# NOTE: values here are FALLBACK / SEED values. The live email provider toggle,
# Razorpay keys, and most runtime config are managed from the DB `settings`
# collection via the admin Settings UI — no redeploy needed to switch them.
# ───────────────────────────────────────────────────────────────────────────

# App
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=LuxStay 3D

# Database
MONGODB_URI=mongodb://127.0.0.1:27017/luxstay
MONGODB_DB_NAME=luxstay

# Auth (JWT). Generate strong values: `openssl rand -base64 48`
JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
AUTH_COOKIE_DOMAIN=localhost

# Background jobs (BullMQ) — added with the jobs module
REDIS_URL=redis://127.0.0.1:6379

# Object storage (room photos, .glb 3D assets, event banners) — S3 / Cloudflare R2
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=luxstay-assets
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_BASE_URL=

# Payments — Razorpay (test keys here; production keys live in DB settings)
RAZORPAY_KEY_ID=rzp_test_xxxxxxxx
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_xxxxxxxx

# Email — fallback/seed creds (live provider chosen from DB settings)
EMAIL_FROM="LuxStay 3D <no-reply@luxstay.example>"
GMAIL_SMTP_USER=
GMAIL_SMTP_PASS=
BREVO_API_KEY=

# SMS (optional, pluggable) — Twilio / MSG91
SMS_PROVIDER=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
MSG91_AUTH_KEY=

# Google OAuth (optional guest login)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Seed admin (created by `pnpm seed`)
SEED_ADMIN_EMAIL=admin@luxstay.example
SEED_ADMIN_PASSWORD=ChangeMe!2026
SEED_ADMIN_NAME=Property Owner
